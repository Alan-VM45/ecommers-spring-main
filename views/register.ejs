<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registrarse - MiEcommerce</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="login-container">
    <div class="login-box">
      <h2>Crear Cuenta</h2>
      
      <% if (errors && errors.length > 0) { %>
        <div class="errors">
          <% errors.forEach(error => { %>
            <p class="error"><%= error %></p>
          <% }); %>
        </div>
      <% } %>
      
      <form action="/register" method="POST">
        <input type="text" name="username" placeholder="Nombre de usuario" value="<%= username %>" required>
        <input type="email" name="email" placeholder="Correo electrónico" value="<%= email %>" required>
        <input type="password" name="password" placeholder="Contraseña" required>
        <button type="submit" class="btn">Registrarse</button>
      </form>
      <p>¿Ya tienes cuenta? <a class="algo" href="/">Inicia sesión</a></p>
    </div>
  </div>

</body>
</html>